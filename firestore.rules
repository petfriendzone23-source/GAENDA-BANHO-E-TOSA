rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper Functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(uid) {
      return isAuthenticated() && request.auth.uid == uid;
    }

    function isAdmin() {
      return isAuthenticated() &&
        (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' ||
          (request.auth.token.email == "petfriendzone23@gmail.com" && request.auth.token.email_verified == true));
    }

    // Validation Functions
    function isValidAppointment(data) {
      return data.clientId is string && data.clientId.size() < 100 &&
             data.petId is string && data.petId.size() < 100 &&
             data.services is list && data.services.size() < 20 &&
             data.date is string && data.date.matches("^\\d{4}-\\d{2}-\\d{2}$") &&
             data.time is string && data.time.matches("^\\d{2}:\\d{2}$") &&
             data.status in ['Agendado', 'Concluído', 'Cancelado'] &&
             data.price is number && data.price >= 0;
    }

    function isValidProduct(data) {
      return data.name is string && data.name.size() > 0 && data.name.size() < 100 &&
             data.type in ['bandana', 'laço', 'perfume'] &&
             data.isAvailable is bool &&
             (!('imageUrl' in data) || (data.imageUrl is string && data.imageUrl.size() < 2000));
    }

    match /users/{uid} {
      allow read, write: if isOwner(uid);

      match /agendamentos/{appointmentId} {
        allow get: if true; // Allow reading specific appointment for client choice
        allow list: if isOwner(uid);
        allow update: if isOwner(uid) || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['clientChoices']));
        allow create: if isOwner(uid) && isValidAppointment(request.resource.data);
        allow delete: if isOwner(uid);
      }

      match /produtos/{productId} {
        allow get: if true; // Allow reading products for client choice
        allow list: if isOwner(uid);
        allow create, update: if isOwner(uid) && isValidProduct(request.resource.data);
        allow delete: if isOwner(uid);
      }

      match /{allSubcollections=**} {
        allow read, write: if isOwner(uid);
      }
    }
  }
}
